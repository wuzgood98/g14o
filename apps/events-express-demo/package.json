{
  "name": "events-express-demo",
  "version": "0.0.4",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @g14o/events build && concurrently -n api,ui -c blue,green \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch server/src/server.ts",
    "dev:client": "vite client",
    "typecheck": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p client/tsconfig.json"
  },
  "dependencies": {
    "@g14o/events": "workspace:*",
    "@hono/node-server": "^1.19.14",
    "express": "^5.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@workspace/typescript-config": "workspace:*",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vite": "^8.0.14"
  }
}
