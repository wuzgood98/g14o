{
  "extends": "@workspace/typescript-config/library-build.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strictNullChecks": true,
    "stripInternal": true,
    "removeComments": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/test-utils/**"]
}
